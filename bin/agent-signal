#!/bin/sh
# shellcheck disable=SC1010,SC2209  # done, "wait", "park" are state words here, not keywords
# agent-signal 0.2.1: per-window AI coding-agent state in the tmux status bar.
#
# State lives in tmux user options, written by agent hooks and read natively
# by the status line. No daemon, no polling, nothing runs on redraw.
#
#   pane   @agent_pane_state  working | blocked | ask | done   (unset = idle / no agent)
#   pane   @agent_kind    claude | codex | pi | ...   (who reported)
#   pane   @agent_name    display name (from Claude's session registry)
#   window @agent_state   aggregate of its panes: blocked > ask > done > working
#   global @agent_summary  one coloured glyph per agent pane, for status-right
#   global @agent_needs    count of windows needing you (blocked or ask), for titles
#   window @agent_hold    wait | park                (user triage override)
#   window @agent_icon / @agent_fg                   what the status bar draws
#   window @agent_tab_owned  1 when window-status-style was set by us
#
# Usage:
#   agent-signal hook <ClaudeHookEvent>        Claude Code hook entry (JSON on stdin)
#   agent-signal set <state> [pane]            generic entry for any agent
#   agent-signal clear [pane]                  agent exited
#   agent-signal seen [window]                 window viewed: done -> idle (default: current)
#   agent-signal next                          jump to the next blocked, else ask, else done window
#   agent-signal hold wait|park|clear [window] triage a window (default: current); wait/park toggle
#   agent-signal list                          tree of sessions/windows/panes (for the switcher)
#   agent-signal sync                          pull names/presence from ~/.claude/sessions
#   agent-signal summary                       recompute the status-right glyphs and needs-you count
#   agent-signal install-claude-hooks          merge hooks into ~/.claude/settings.json (needs jq)
#   agent-signal check                         report what is wired and what is missing (exit 1 if broken)
#   agent-signal uninstall                     undo everything the entry file set on the server
#   agent-signal lock-path <window>            print the lock directory used for that window (debugging)
#   agent-signal help | version
set -u

PLUGIN_DIR=$(cd "$(dirname "$0")/.." && pwd)
SELF="$PLUGIN_DIR/bin/agent-signal"

# --- tmux binary -----------------------------------------------------------
# Hooks run with whatever PATH the agent had. Homebrew also unlinks tmux while
# it builds an upgrade, so fall back to known install locations.
if command -v tmux >/dev/null 2>&1; then
  TMUX_BIN=tmux
else
  TMUX_BIN=""
  for c in /opt/homebrew/bin/tmux /usr/local/bin/tmux /usr/bin/tmux /opt/homebrew/Cellar/tmux/*/bin/tmux /usr/local/Cellar/tmux/*/bin/tmux; do
    [ -x "$c" ] && TMUX_BIN=$c && break
  done
  [ -n "$TMUX_BIN" ] || exit 0
fi
t() { "$TMUX_BIN" "$@"; }

case ${1:-} in install-claude-hooks|help|-h|--help|version|--version) ;; *) [ -n "${TMUX:-}" ] || exit 0 ;; esac

# --- options ---------------------------------------------------------------
opt() { # opt <name> <default>
  v=$(t show-option -gqv "$1" 2>/dev/null)
  [ -n "$v" ] && printf '%s' "$v" || printf '%s' "$2"
}

# --- helpers ---------------------------------------------------------------
json_get() { # json_get <jq-filter> <sed-key-fallback>: a string value by key
  if command -v jq >/dev/null 2>&1; then
    printf '%s' "$JSON" | jq -r "$1 // empty" 2>/dev/null
  else
    # First occurrence of "key": "value", tolerating whitespace around the colon.
    printf '%s' "$JSON" | tr -d '\n' | sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" | head -1
  fi
}

json_array_nonempty() { # json_array_nonempty <jq-path> <key>: 0 if the array has elements
  if command -v jq >/dev/null 2>&1; then
    [ "$(printf '%s' "$JSON" | jq -r "($1 // []) | length" 2>/dev/null)" -gt 0 ] 2>/dev/null
  else
    printf '%s' "$JSON" | tr -d '\n' | grep -q "\"$2\"[[:space:]]*:[[:space:]]*\[[[:space:]]*[^]\t ]"
  fi
}

resolve_pane() { # resolve_pane [pane] -> echoes pane id
  p=${1:-${TMUX_PANE:-}}
  [ -n "$p" ] || p=$(t display -p '#{pane_id}')
  printf '%s' "$p"
}

window_of() { t display -p -t "$1" '#{window_id}'; }

# Pane state is kept under its own option name (@agent_pane_state) so that
# formats never fall through to the window's @agent_state via inheritance.
pane_state() { t display -p -t "$1" '#{@agent_pane_state}' 2>/dev/null; }
pane_opt()   { t display -p -t "$1" "#{$2}" 2>/dev/null; }

visible() { # visible <window> -> 0 if that window is on screen in an attached client
  [ "$(t display -p -t "$1" '#{window_active}#{?session_attached,1,0}')" = "11" ]
}

play() { # play <state>
  [ "$(opt @agent_signal_sound on)" = on ] || return 0
  case $1 in
    blocked) s=$(opt @agent_signal_sound_blocked Ping) ;;
    ask)     s=$(opt @agent_signal_sound_ask "$(opt @agent_signal_sound_blocked Ping)") ;;
    done)    s=$(opt @agent_signal_sound_done Glass) ;;
    *) return 0 ;;
  esac
  [ "$s" = off ] && return 0
  if [ -x /usr/bin/afplay ]; then
    f=$s; [ -f "$f" ] || f="/System/Library/Sounds/$s.aiff"
    (/usr/bin/afplay "$f" >/dev/null 2>&1 &)
  elif command -v paplay >/dev/null 2>&1; then
    (paplay "$s" >/dev/null 2>&1 &)
  fi
}

notify() { # notify <state> <window>
  [ "$(opt @agent_signal_notify off)" = on ] || return 0
  title="Agent $1"
  body=$(t display -p -t "$2" '#{session_name}:#{window_index} #{window_name}')
  if command -v terminal-notifier >/dev/null 2>&1; then
    (terminal-notifier -title "$title" -message "$body" >/dev/null 2>&1 &)
  elif command -v osascript >/dev/null 2>&1; then
    (osascript -e "display notification \"$body\" with title \"$title\"" >/dev/null 2>&1 &)
  elif command -v notify-send >/dev/null 2>&1; then
    (notify-send "$title" "$body" >/dev/null 2>&1 &)
  fi
}

# Your own alert: @agent_signal_alert_command runs in the background on a state
# transition (never on a repeat of the same state). tmux formats in it are
# expanded against the window; the shell sees AGENT_SIGNAL_STATE,
# AGENT_SIGNAL_PREV, AGENT_SIGNAL_WINDOW and AGENT_SIGNAL_PANE.
alert_command() { # alert_command <state> <prev> <window> <pane>
  cmd=$(opt @agent_signal_alert_command "")
  [ -n "$cmd" ] || return 0
  case " $(opt @agent_signal_alert_states "blocked ask done") " in *" $1 "*) ;; *) return 0 ;; esac
  # display-message runs strftime over its output, so protect literal % signs.
  expanded=$(t display -p -t "$3" "$(printf '%s' "$cmd" | sed 's/%/%%/g')")
  (AGENT_SIGNAL_STATE=$1 AGENT_SIGNAL_PREV=$2 AGENT_SIGNAL_WINDOW=$3 AGENT_SIGNAL_PANE=$4 \
     sh -c "$expanded" >/dev/null 2>&1 </dev/null &)
}

bell() { # bell <pane>: ring tmux's own bell in that pane (monitor-bell, SSH-safe)
  [ "$(opt @agent_signal_bell off)" = on ] || return 0
  tty=$(t display -p -t "$1" '#{pane_tty}')
  [ -w "$tty" ] && printf '\a' > "$tty"
}

# --- state -----------------------------------------------------------------
style_for() { # style_for <state|hold> -> "icon fg bg"
  if [ "$(opt @agent_signal_ascii off)" = on ]; then
    d_done="+ black green"; d_wait=". colour245 default"; d_ask="? black colour213"
  else
    d_done="✓ black green"; d_wait="… colour245 default"; d_ask="? black colour213"
  fi
  case $1 in
    working) printf '%s' "$(opt @agent_signal_working "~ yellow default")" ;;
    blocked) printf '%s' "$(opt @agent_signal_blocked "! black colour208")" ;;
    ask)     printf '%s' "$(opt @agent_signal_ask "$d_ask")" ;;
    done)    printf '%s' "$(opt @agent_signal_done "$d_done")" ;;
    wait)    printf '%s' "$(opt @agent_signal_wait "$d_wait")" ;;
    park)    printf '%s' "$(opt @agent_signal_park "p colour240 default")" ;;
    *)       printf '' ;;
  esac
}

needs_you() { case $1 in blocked|ask) return 0 ;; *) return 1 ;; esac; }

# Only ever unset a window-status-style that we set ourselves: a theme or the
# user may have styled that window, and @agent_tab_owned records that the
# current value is ours.
restore_tab() { # restore_tab <window>
  if [ "$(t show-option -wqv -t "$1" @agent_tab_owned)" = 1 ]; then
    t set-option -uw -t "$1" window-status-style
    t set-option -uw -t "$1" @agent_tab_owned
  fi
}

paint_window() { # paint_window <window> <state-or-hold>
  set -- "$1" "$(style_for "$2")" "$2"
  case $2 in
    ""|*' '*' '*) ;;   # empty, or the three fields we need
    *) echo "agent-signal: option for '$3' must be '<icon> <fg> <bg>', got '$2'" >&2; return 0 ;;
  esac
  if [ -z "$2" ]; then
    t set-option -uw -t "$1" @agent_icon \; set-option -uw -t "$1" @agent_fg
    restore_tab "$1"
    return
  fi
  icon=${2%% *}; rest=${2#* }; fg=${rest%% *}; bg=${rest#* }
  # @agent_signal_tab_colour: all (every state with a bg), needs (only when a
  # window needs you), off (badge only). "on" is kept as an alias of all.
  colour_tab=1
  case $(opt @agent_signal_tab_colour all) in
    off) colour_tab=0 ;;
    needs) needs_you "$3" || colour_tab=0 ;;
  esac
  if [ "$bg" = default ] || [ "$colour_tab" = 0 ]; then
    t set-option -w -t "$1" @agent_icon "$icon" \; set-option -w -t "$1" @agent_fg "$fg"
    restore_tab "$1"
  else
    t set-option -w -t "$1" @agent_icon "$icon" \; set-option -w -t "$1" @agent_fg "$fg" \
      \; set-option -w -t "$1" window-status-style "fg=$fg,bg=$bg,bold" \; set-option -w -t "$1" @agent_tab_owned 1
  fi
}

# Claude runs hooks concurrently, and refreshing a window is a read-modify-write
# across many tmux calls. A per-window mkdir lock keeps two hooks for panes in
# the same window from overwriting each other's result.
# Window ids repeat across tmux servers, so the lock is keyed on the server's
# socket path as well (a checksum keeps the name short and free of slashes).
lock_path() { # lock_path <window>
  printf '%s/agent-signal.%s.lock.%s.%s' "${TMPDIR:-/tmp}" "$(id -u)" "$(printf '%s' "${TMUX%%,*}" | cksum | cut -d' ' -f1)" "${1#@}"
}
lock_window() { # lock_window <window>
  LOCK=$(lock_path "$1")
  i=0
  until mkdir "$LOCK" 2>/dev/null; do
    i=$((i + 1))
    [ "$i" -gt 100 ] && { rmdir "$LOCK" 2>/dev/null; continue; }   # stale lock (killed holder): reclaim
    sleep 0.02
  done
  trap 'rmdir "$LOCK" 2>/dev/null' EXIT INT TERM
}
unlock_window() { rmdir "${LOCK:-/nonexistent}" 2>/dev/null; trap - EXIT INT TERM; }

clear_done_panes() { # clear_done_panes <window>: acknowledge every done pane
  t list-panes -t "$1" -F '#{pane_id}	#{@agent_pane_state}' | while IFS='	' read -r p st; do
    [ "$st" = done ] && t set-option -up -t "$p" @agent_pane_state
  done
}

BADGE='#{?#{@agent_icon}, #[fg=#{@agent_fg}#,bold]#{@agent_icon}#[default],}'

# A theme that sets window-status-format per window outranks the global one
# and hides the badge on that window. Weave it into the window's own value.
mend_window_format() { # mend_window_format <window>
  for o in window-status-format window-status-current-format; do
    cur=$(t show-option -wqv -t "$1" "$o")
    [ -n "$cur" ] || continue
    case $cur in *@agent_icon*) ;; *) t set-option -w -t "$1" "$o" "${cur}${BADGE}" ;; esac
  done
}

refresh_window() { # refresh_window <window> [event]
  win=$1; ev=${2:-}
  mend_window_format "$win"
  # One round trip for the window's previous state and hold.
  IFS='	' read -r prev hold <<EOF2
$(t display -p -t "$win" '#{@agent_state}	#{@agent_hold}')
EOF2
  agg=""
  # One round trip for every pane's state.
  for st in $(t list-panes -t "$win" -F '#{?@agent_pane_state,#{@agent_pane_state},-}'); do
    case $st in
      blocked) agg=blocked ;;
      ask)     [ "$agg" != blocked ] && agg=ask ;;
      done)    needs_you "$agg" || agg=done ;;
      working) [ -z "$agg" ] && agg=working ;;
    esac
  done

  # Something new happened -> a "wait" hold has served its purpose.
  if [ "$hold" = wait ] && [ -n "$ev" ] && [ "$agg" != "$prev" ]; then
    hold=""; t set-option -uw -t "$win" @agent_hold
  fi

  # Finished while you were already looking at it -> nothing to flag.
  if [ "$agg" = done ] && [ -n "$ev" ] && visible "$win"; then
    clear_done_panes "$win"
    agg=""
  fi

  if [ -n "$agg" ]; then t set-option -w -t "$win" @agent_state "$agg"; else t set-option -uw -t "$win" @agent_state; fi

  if [ -n "$hold" ] && ! needs_you "$agg"; then paint_window "$win" "$hold"; else paint_window "$win" "$agg"; fi

  if [ -n "$ev" ] && [ "$agg" != "$prev" ] && [ -z "$hold" ]; then
    case $agg in blocked|ask|done)
      visible "$win" || { play "$agg"; notify "$agg" "$win"; }
      alert_command "$agg" "$prev" "$win" "${EVENT_PANE:-}" ;;
    esac
  fi
  refresh_summary
}

refresh_summary() { # one glyph per agent pane, coloured by state; count of windows needing you
  # Read the nine colour/glyph options once, not once per pane.
  c_working=$(opt @agent_signal_colour_working yellow)
  c_blocked=$(opt @agent_signal_colour_blocked colour208)
  c_ask=$(opt @agent_signal_colour_ask colour213)
  c_done=$(opt @agent_signal_colour_done green)
  c_idle=$(opt @agent_signal_colour_idle colour245)
  g_claude=$(opt @agent_signal_glyph_claude '✳')
  g_codex=$(opt @agent_signal_glyph_codex '⬢')
  g_pi=$(opt @agent_signal_glyph_pi 'π')
  g_other=$(opt @agent_signal_glyph_other '●')
  # One list-panes, one awk: prints "<glyphs>\t<windows needing you>". Dead panes
  # (remain-on-exit) are skipped so a crashed agent does not linger as a glyph.
  out=$(t list-panes -a -F '#{window_id}	#{?@agent_kind,#{@agent_kind},-}	#{?@agent_pane_state,#{@agent_pane_state},-}	#{window_index}	#{pane_dead}' \
    | awk -F'	' -v cw="$c_working" -v cb="$c_blocked" -v ca="$c_ask" -v cd="$c_done" -v ci="$c_idle" \
          -v gc="$g_claude" -v gx="$g_codex" -v gp="$g_pi" -v go="$g_other" '
      $2 == "-" || $5 == "1" { next }
      { c = ci; if ($3 == "working") c = cw; else if ($3 == "blocked") c = cb; else if ($3 == "ask") c = ca; else if ($3 == done) c = cd
        g = go; if ($2 == "claude") g = gc; else if ($2 == "codex") g = gx; else if ($2 == "pi") g = gp
        # "<glyph><window index>" so the summary doubles as a jump list: prefix + <index>
        glyphs = glyphs (glyphs == "" ? "" : " ") "#[fg=" c "]" g $4
        if (($3 == "blocked" || $3 == "ask") && !seen[$1]++) needs++ }
      END { printf "%s\t%d\n", glyphs, needs }')
  glyphs=${out%	*}; needs=${out#*	}
  if [ -n "$glyphs" ]; then t set-option -g @agent_summary "${glyphs}#[default] "; else t set-option -gu @agent_summary; fi
  if [ "$needs" -gt 0 ]; then t set-option -g @agent_needs "$needs"; else t set-option -gu @agent_needs; fi
}

# A hook can fire before tmux has sourced the entry file (plugin installed,
# tmux not yet reloaded). Wire the server up on the spot rather than dropping
# the event; the entry file is idempotent, so a later reload changes nothing.
bootstrap_if_needed() {
  case $(t show-option -gqv window-status-format) in *@agent_icon*) ;; *) sh "$PLUGIN_DIR/agent-signal.tmux" >/dev/null 2>&1 ;; esac
}

set_state() { # set_state <state> [pane]
  bootstrap_if_needed
  pane=$(resolve_pane "${2:-}"); EVENT_PANE=$pane
  win=$(window_of "$pane") || exit 0
  lock_window "$win"
  case $1 in
    working|blocked|ask|done) t set-option -p -t "$pane" @agent_pane_state "$1" ;;
    idle|clear|"")        t set-option -up -t "$pane" @agent_pane_state ;;
    *) echo "agent-signal: unknown state '$1'" >&2; exit 1 ;;
  esac
  if [ "$1" = clear ]; then
    t set-option -up -t "$pane" @agent_kind; t set-option -up -t "$pane" @agent_name
  else
    t set-option -p -t "$pane" @agent_kind "${AGENT_KIND:-agent}"
  fi
  needs_you "$1" && bell "$pane"
  refresh_window "$win" event
  unlock_window
}

# --- Claude Code hook mapping ---------------------------------------------
hook() {
  JSON=$(cat 2>/dev/null || true)
  AGENT_KIND=claude
  case $1 in
    SessionStart)      set_state idle; sync_registry ;;
    UserPromptSubmit|PostToolUse) set_state working ;;
    PreToolUse)
      case $(json_get '.tool_name' tool_name) in
        # A question is a tool call that waits on you. Plan approval is not
        # listed: it arrives as a PermissionRequest like any other prompt, and
        # mapping it here too would flag (and sound) the same wait twice.
        AskUserQuestion) set_state ask ;;
        *) set_state working ;;
      esac ;;
    PermissionRequest) set_state blocked ;;
    Notification)
      case $(json_get '.notification_type' notification_type) in
        permission_prompt) set_state blocked ;;
        elicitation*|agent_needs_input) set_state ask ;;
        idle_prompt)
          # Fires ~60s after any finish. Only a pane still marked working needs
          # rescuing (turn ended without a Stop, e.g. Esc); otherwise leave it.
          if [ "$(pane_state "$(resolve_pane)")" = working ]; then set_state done; fi ;;
      esac ;;
    Stop|StopFailure)
      if json_array_nonempty '.background_tasks' background_tasks; then set_state working; else set_state done; fi ;;
    SessionEnd)        set_state clear ;;
  esac
}

# --- Claude session registry (names, presence) -----------------------------
sync_registry() {
  dir="$HOME/.claude/sessions"; [ -d "$dir" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  for f in "$dir"/*.json; do
    [ -f "$f" ] || continue
    jq -r 'select(.tmux != null and .tmux != "") | "\(.tmux)\t\(.name // "-")"' "$f" 2>/dev/null \
    | { IFS='	' read -r tm name || exit 0
        pane="%${tm##*.%}"
        # The registry names session:window.pane; require all three to match so a
        # stale entry, or another server reusing the same pane number, is ignored.
        loc=$(t display -p -t "$pane" '#{session_name}:#{window_id}.#{pane_id}' 2>/dev/null) || exit 0
        [ "$loc" = "$tm" ] || exit 0
        [ -n "$name" ] && [ "$name" != - ] && t set-option -p -t "$pane" @agent_name "$name"
        t set-option -p -t "$pane" @agent_kind claude; }
  done
  refresh_summary
}

# --- navigation & triage ---------------------------------------------------
current_window() { t display -p '#{window_id}'; }

seen() { # seen [window]: the hook passes its own window so a second attached client is never confused
  win=${1:-$(current_window)}
  [ "$(t show-option -wqv -t "$win" @agent_state)" = done ] || return 0
  lock_window "$win"
  clear_done_panes "$win"
  refresh_window "$win"
  unlock_window
}

next() {
  cur=$(current_window)
  # Tab separated, session *id* rather than name: names may contain spaces.
  list=$(t list-windows -a -F '#{window_id}	#{session_id}	#{?@agent_state,#{@agent_state},-}	#{?@agent_hold,#{@agent_hold},-}')
  # rotate so we scan the windows after the current one first
  after=$(printf '%s\n' "$list" | sed -n "/^$cur	/,\$p" | sed '1d')
  before=$(printf '%s\n' "$list" | sed "/^$cur	/,\$d")
  ordered=$(printf '%s\n%s\n' "$after" "$before")
  for want in blocked ask done; do
    target=$(printf '%s\n' "$ordered" | awk -F'	' -v w="$want" '$3==w && $4=="-" {print $1"\t"$2; exit}')
    if [ -n "$target" ]; then
      t switch-client -t "${target#*	}" 2>/dev/null
      t select-window -t "${target%%	*}"
      return 0
    fi
  done
  t display-message "agent-signal: nothing needs you"
}

hold() { # hold wait|park|clear [window]
  win=${2:-$(current_window)}
  lock_window "$win"
  cur=$(t show-option -wqv -t "$win" @agent_hold)
  case $1 in
    clear) t set-option -uw -t "$win" @agent_hold ;;
    wait|park)
      if [ "$cur" = "$1" ]; then t set-option -uw -t "$win" @agent_hold
      else t set-option -w -t "$win" @agent_hold "$1"; fi ;;
  esac
  refresh_window "$win"
  unlock_window
}

# --- listing for the switcher ---------------------------------------------
# kind<TAB>target<TAB>display
list() {
  sync_registry
  t list-sessions -F '#{session_name}' | while read -r s; do
    sstate=$(t list-windows -t "$s" -F '#{@agent_state}' | awk '/blocked/{b=1} /ask/{a=1} /done/{d=1} /working/{w=1} END{if(b)print "!";else if(a)print "?";else if(d)print "+";else if(w)print "~"}')
    printf 'S\t%s\t%s %s\n' "$s" "${sstate:- }" "$s"
    # tab-separated; empty fields are sent as "-" because `read` collapses runs of tabs
    t list-windows -t "$s" -F '#{window_id}	#{window_index}	#{?window_name,#{window_name},-}	#{?@agent_state,#{@agent_state},-}	#{?@agent_hold,#{@agent_hold},-}	#{window_panes}' \
    | while IFS='	' read -r wid idx name st hd np; do
        [ "$name" = - ] && name=""; [ "$st" = - ] && st=""; [ "$hd" = - ] && hd=""
        mark=$(style_for "${hd:-$st}"); mark=${mark%% *}
        # icons are multibyte, so pad with a literal rather than %-2s (which counts bytes)
        printf 'W\t%s\t%s    %s:%s%s\n' "$wid" "${mark:- }" "$idx" "$name" "${hd:+ ($hd)}"
        [ "$np" -gt 1 ] || [ -n "$st" ] || continue
        t list-panes -t "$wid" -F '#{pane_id}	#{pane_index}	#{?pane_current_command,#{pane_current_command},-}' \
        | while IFS='	' read -r pid pidx pc; do
            pst=$(pane_state "$pid"); pk=$(pane_opt "$pid" @agent_kind); pn=$(pane_opt "$pid" @agent_name)
            m=$(style_for "$pst"); m=${m%% *}
            printf 'P\t%s\t%s       %s: %s\n' "$pid" "${m:- }" "$pidx" "${pn:-${pk:-$pc}}"
          done
      done
  done
}

# --- installer -------------------------------------------------------------
install_claude_hooks() {
  settings="$HOME/.claude/settings.json"
  command -v jq >/dev/null 2>&1 || { echo "jq is required to merge hooks; see docs/claude-hooks.json for a manual copy" >&2; exit 1; }
  [ -f "$settings" ] || { mkdir -p "$(dirname "$settings")" && printf '{}\n' > "$settings"; }
  # Keep the first backup: it is the only copy of the settings as they were before us.
  [ -f "$settings.bak-agent-signal" ] || cp "$settings" "$settings.bak-agent-signal"
  tmp=$(mktemp "$settings.XXXXXX") || exit 1
  trap 'rm -f "$tmp"' EXIT INT TERM
  # The path is double-quoted inside the command because Claude runs hooks
  # through a shell and a plugin directory may contain spaces.
  jq --arg bin "$SELF" '
    def entry($ev): {matcher: "", hooks: [{type: "command", command: ("\"" + $bin + "\" hook " + $ev), async: true}]};
    def add($ev): .hooks[$ev] = ((.hooks[$ev] // []) | map(select((.hooks // []) | any(.command | tostring | contains("agent-signal\" hook") or contains("agent-signal hook")) | not)) + [entry($ev)]);
    .hooks //= {} |
    reduce ("SessionStart","UserPromptSubmit","PreToolUse","PostToolUse","PermissionRequest","Notification","Stop","StopFailure","SessionEnd") as $ev (.; add($ev))
  ' "$settings" > "$tmp" && mv "$tmp" "$settings" && echo "hooks merged into $settings (backup: $settings.bak-agent-signal)"
}

# --- check -----------------------------------------------------------------
# What is wired, what is missing, and whether anything reports. Exits 1 if
# something the plugin relies on is not in place.
check() {
  bad=0
  say() { printf '  %-4s %s\n' "$1" "$2"; [ "$1" = fail ] && bad=1; return 0; }
  echo "agent-signal $(sed -n 's/^# agent-signal \([0-9.]*\):.*/\1/p' "$0") on tmux $(t display -p '#{version}')"
  [ -n "${TMUX:-}" ] && say ok "inside tmux ($TMUX_BIN)" || say fail "TMUX is not set: run this from a pane"
  [ "$(t show-option -gqv @agent_signal_command)" = "$SELF" ] && say ok "command path published" || say fail "@agent_signal_command not published: source agent-signal.tmux"
  case $(t show-option -gv window-status-format) in *@agent_icon*) say ok "badge in window-status-format" ;; *) say fail "badge missing from window-status-format" ;; esac
  case $(t show-option -gv status-right) in *@agent_summary*) say ok "summary in status-right" ;; *) say warn "summary not in status-right" ;; esac
  n=$(t show-hooks -g | grep -c "agent-signal"); [ "$n" -ge 5 ] && say ok "$n hooks installed" || say fail "only $n of 5 hooks installed"
  for k in next switcher wait park; do
    key=$(opt "@agent_signal_key_$k" "")
    [ -z "$key" ] && { case $k in next) key=N ;; switcher) key=A ;; wait) key=W ;; park) key=P ;; esac; }
    if t list-keys -T prefix | awk -v k="$key" '$4 == k' | grep -qE 'agent-signal|switcher'; then say ok "prefix+$key -> $k"; else say warn "prefix+$key is not ours ($k unbound)"; fi
  done
  themed=$(t list-windows -a -F '#{window_id}	#{?window-status-format,#{window-status-format},-}' | awk -F'	' '$2 != "-" && $2 !~ /@agent_icon/ {print $1}' | tr '\n' ' ')
  [ -z "$themed" ] && say ok "no window overrides its format without the badge" || say warn "windows with an unmended format override: $themed (fixed on their next event)"
  agents=$(t list-panes -a -F '#{?@agent_kind,1,}' | grep -c 1); say ok "$agents pane(s) report an agent"
  for tool in jq fzf; do command -v $tool >/dev/null 2>&1 && say ok "$tool found" || say warn "$tool not found ($( [ $tool = jq ] && echo 'sed fallback for hooks; installer unavailable' || echo 'switcher unavailable'))"; done
  [ -x /usr/bin/afplay ] || command -v paplay >/dev/null 2>&1 && say ok "sound player found" || say warn "no sound player (afplay/paplay)"
  return $bad
}

# --- uninstall -------------------------------------------------------------
# The inverse of agent-signal.tmux plus a sweep of live windows and panes.
uninstall() {
  for o in window-status-format window-status-current-format status-right; do
    cur=$(t show-option -gqv "$o")
    case $o in
      status-right) new=${cur#"#{@agent_summary}"} ;;
      *) new=${cur%"#{?#{@agent_icon}, #[fg=#{@agent_fg}#,bold]#{@agent_icon}#[default],}"} ;;
    esac
    [ "$new" != "$cur" ] && t set-option -g "$o" "$new"
  done
  for h in after-select-window client-session-changed client-attached pane-exited after-kill-pane window-unlinked; do
    t set-hook -gu "${h}[91]" 2>/dev/null
  done
  for k in "$(opt @agent_signal_key_next N)" "$(opt @agent_signal_key_switcher A)" "$(opt @agent_signal_key_wait W)" "$(opt @agent_signal_key_park P)"; do
    [ -n "$k" ] && t list-keys -T prefix | awk -v k="$k" '$4 == k' | grep -q agent-signal && t unbind-key -T prefix "$k"
  done
  for w in $(t list-windows -a -F '#{window_id}'); do
    restore_tab "$w"
    t set-option -uw -t "$w" @agent_state \; set-option -uw -t "$w" @agent_hold \; set-option -uw -t "$w" @agent_icon \; set-option -uw -t "$w" @agent_fg
  done
  for p in $(t list-panes -a -F '#{pane_id}'); do
    t set-option -up -t "$p" @agent_pane_state \; set-option -up -t "$p" @agent_kind \; set-option -up -t "$p" @agent_name
  done
  t set-option -gu @agent_summary; t set-option -gu @agent_needs; t set-option -gu @agent_signal_command
  echo "agent-signal: removed formats, hooks, key bindings and window/pane state. Claude hooks in ~/.claude/settings.json are left for you to delete."
}

# --- dispatch --------------------------------------------------------------
usage() { sed -n '/^# Usage:/,/^set -u/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; }
case ${1:-} in
  hook)   [ -n "${2:-}" ] || { echo "agent-signal hook: which event? e.g. Stop" >&2; exit 1; }; hook "$2" ;;
  set)    [ -n "${2:-}" ] || { echo "agent-signal set: which state? working|blocked|ask|done|idle" >&2; exit 1; }; set_state "$2" "${3:-}" ;;
  clear)  set_state clear "${2:-}" ;;
  seen)   seen "${2:-}" ;;
  summary) refresh_summary ;;
  badge-format) printf '%s\n' "$BADGE" ;;
  lock-path) lock_path "${2:?window}" ;;
  next)   next ;;
  hold)   case ${2:-} in wait|park|clear) hold "$2" "${3:-}" ;; *) echo "agent-signal hold: wait, park or clear" >&2; exit 1 ;; esac ;;
  list)   list ;;
  sync)   sync_registry ;;
  install-claude-hooks) install_claude_hooks ;;
  uninstall) uninstall ;;
  check)  check ;;
  help|-h|--help) usage ;;
  version|--version) sed -n 's/^# agent-signal \([0-9.]*\):.*/\1/p' "$0" ;;
  "") usage >&2; exit 1 ;;
  *) echo "agent-signal: unknown command '$1'" >&2; usage >&2; exit 1 ;;
esac

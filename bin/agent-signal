#!/bin/sh
# shellcheck disable=SC1010,SC2209  # done, "wait", "park" are state words here, not keywords
# agent-signal 0.5.1: per-window AI coding-agent state in the tmux status bar.
#
# State lives in tmux user options, written by agent hooks and read natively
# by the status line. No daemon, no polling, nothing runs on redraw.
#
#   pane   @agent_pane_state  working | blocked | ask | done   (unset = idle / no agent)
#   pane   @agent_kind    claude | codex | pi | ...   (who reported)
#   pane   @agent_name    display name (from Claude's session registry)
#   window @agent_state   aggregate of its panes: blocked > ask > done > working
#   window @agent_since   epoch seconds when @agent_state last changed (next serves the oldest first)
#   global @agent_needs    count of windows needing you (blocked or ask), for titles
#   global @agent_limits   usage meter for your own status line (only with @agent_signal_limits on)
#   global @agent_limit_<claude|codex>_<5h|7d>_used / _reset and @agent_limit_<agent>_at: what it is built from
#   (the terminal's OSC 9;4 progress bar is written to each client's tty, not stored)
#   window @agent_hold    wait | park                (user triage override)
#   window @agent_icon / @agent_fg                   what the status bar draws
#   (pane-border-style reads @agent_pane_state directly: a split pane that needs you gets a coloured border)
#   window @agent_tab_owned  1 when window-status-style was set by us
#   window @agent_tab_saved  the style that was there before we took the tab over
#
# Usage:
#   agent-signal hook <ClaudeHookEvent>        Claude Code hook entry (JSON on stdin)
#   agent-signal set <state> [pane]            generic entry for any agent
#   agent-signal clear [pane]                  agent exited
#   agent-signal seen [window]                 window viewed: done -> idle (default: current)
#   agent-signal next                          jump to the next blocked, else ask, else done window, longest wait first
#   agent-signal hold wait|park|clear [window] triage a window (default: current); wait/park toggle
#   agent-signal list                          tree of sessions/windows/panes (for the switcher)
#   agent-signal sync                          pull names/presence from ~/.claude/sessions
#   agent-signal needs                         recompute the needs-you count
#   agent-signal progress [print|clear]        redraw the terminal progress bar (print: show, don't write)
#   agent-signal limits                        recompute the usage meter (@agent_limits), or clear it when switched off
#   agent-signal statusline [command]          Claude Code statusLine entry: record usage limits, then run command
#   agent-signal install-claude-hooks          merge hooks into ~/.claude/settings.json (needs jq)
#   agent-signal install-claude-statusline     point Claude's statusLine here, keeping yours (needs jq)
#   agent-signal check                         report what is wired and what is missing (exit 1 if broken)
#   agent-signal uninstall                     undo everything the entry file set on the server
#   agent-signal lock-path <window>            print the lock directory used for that window (debugging)
#   agent-signal help | version
set -u

PLUGIN_DIR=$(cd "$(dirname "$0")/.." && pwd)
SELF="$PLUGIN_DIR/bin/agent-signal"

# --- tmux binary -----------------------------------------------------------
# Hooks run with whatever PATH the agent had. Homebrew also unlinks tmux while
# it builds an upgrade, so fall back to known install locations.
if command -v tmux >/dev/null 2>&1; then
  TMUX_BIN=tmux
else
  TMUX_BIN=""
  for c in /opt/homebrew/bin/tmux /usr/local/bin/tmux /usr/bin/tmux /opt/homebrew/Cellar/tmux/*/bin/tmux /usr/local/Cellar/tmux/*/bin/tmux; do
    [ -x "$c" ] && TMUX_BIN=$c && break
  done
  # (statusline still has the previous status line command to run, and
  # uninstall still has Claude's statusLine to put back.)
  [ -n "$TMUX_BIN" ] || case ${1:-} in statusline|uninstall) ;; *) exit 0 ;; esac
fi
t() { "$TMUX_BIN" "$@"; }

case ${1:-} in install-claude-hooks|install-claude-statusline|statusline|uninstall|check|help|-h|--help|version|--version) ;; *) [ -n "${TMUX:-}" ] || exit 0 ;; esac
# An agent launched from inside another agent's pane would report over its
# parent, and its SessionStart would relabel the pane from Claude's registry.
# AGENT_SIGNAL_DISABLE=1 on the nested command silences every report.
case ${1:-} in hook|set|clear|sync) case ${AGENT_SIGNAL_DISABLE:-} in ""|0|off|false) ;; *) exit 0 ;; esac ;; esac

# --- options ---------------------------------------------------------------
opt() { # opt <name> <default>
  v=$(t show-option -gqv "$1" 2>/dev/null)
  [ -n "$v" ] && printf '%s' "$v" || printf '%s' "$2"
}
# Like opt, but an option deliberately set to "" stays "" (a key binding or an
# alert-states list can be switched off that way).
opt_set() { # opt_set <name> <default>
  if [ -n "$(t show-options -gq "$1" 2>/dev/null)" ]; then t show-option -gqv "$1" 2>/dev/null; else printf '%s' "$2"; fi
}

# --- helpers ---------------------------------------------------------------
json_get() { # json_get <jq-filter> <sed-key-fallback>: a string value by key
  if command -v jq >/dev/null 2>&1; then
    printf '%s' "$JSON" | jq -r "$1 // empty" 2>/dev/null
  else
    # First occurrence of "key": "value", tolerating whitespace around the colon.
    # grep -o isolates each match, so the first one is the top-level key rather
    # than, as a greedy sed substitution would give, the last (a nested one).
    printf '%s' "$JSON" | tr -d '\n' | grep -o "\"$2\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" | head -1 | sed 's/^[^:]*:[[:space:]]*"\(.*\)"$/\1/'
  fi
}

json_array_nonempty() { # json_array_nonempty <jq-path> <key>: 0 if the array has elements
  if command -v jq >/dev/null 2>&1; then
    [ "$(printf '%s' "$JSON" | jq -r "($1 // []) | length" 2>/dev/null)" -gt 0 ] 2>/dev/null
  else
    # An element is anything after the bracket that is neither ] nor blank.
    printf '%s' "$JSON" | tr -d '\n' | grep -q "\"$2\"[[:space:]]*:[[:space:]]*\[[[:space:]]*[^][:space:]]"
  fi
}

resolve_pane() { # resolve_pane [pane] -> echoes pane id
  p=${1:-${TMUX_PANE:-}}
  [ -n "$p" ] || p=$(pane_by_ancestry)
  [ -n "$p" ] || p=$(t display -p '#{pane_id}')
  printf '%s' "$p"
}

# Claude occasionally runs a hook without TMUX_PANE. The client's active pane
# is the wrong answer whenever you are looking at another window, so walk this
# process's parents until one of them is a pane's shell.
pane_by_ancestry() {
  # A dead pane (remain-on-exit) keeps its old pid, which the kernel may hand
  # to a later process; never attribute a report to one.
  panes=$(t list-panes -a -F '#{pane_pid} #{pane_id} #{pane_dead}' | awk '$3 != 1 { print $1, $2 }')
  pid=$$; i=0
  while [ "$pid" -gt 1 ] && [ $i -lt 40 ]; do
    hit=$(printf '%s\n' "$panes" | awk -v p="$pid" '$1 == p { print $2; exit }')
    [ -n "$hit" ] && { printf '%s' "$hit"; return 0; }
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
    [ -n "$pid" ] || return 1
    i=$((i + 1))
  done
  return 1
}

window_of() { t display -p -t "$1" '#{window_id}'; }

# Pane state is kept under its own option name (@agent_pane_state) so that
# formats never fall through to the window's @agent_state via inheritance.
pane_state() { t display -p -t "$1" '#{@agent_pane_state}' 2>/dev/null; }
pane_opt()   { t display -p -t "$1" "#{$2}" 2>/dev/null; }

visible() { # visible <window> -> 0 if a focused client is showing that window
  # Attached is not enough: with one session per terminal tab every session
  # is attached, but only the focused tab is on screen. tmux tracks focus from
  # the terminal's focus reports (focus-events); a client starts out focused
  # and stays so when its terminal never reports, which keeps the old meaning.
  t list-clients -F '#{window_id} #{client_flags}' |
    awk -v w="$1" '$1 == w && ("," $2 ",") ~ /,focused,/ { found = 1 } END { exit !found }'
}

play() { # play <state>
  [ "$(opt @agent_signal_sound on)" = on ] || return 0
  case $1 in
    blocked) s=$(opt @agent_signal_sound_blocked Ping) ;;
    ask)     s=$(opt @agent_signal_sound_ask "$(opt @agent_signal_sound_blocked Ping)") ;;
    done)    s=$(opt @agent_signal_sound_done Glass) ;;
    *) return 0 ;;
  esac
  [ "$s" = off ] && return 0
  if [ -x /usr/bin/afplay ]; then
    f=$s; [ -f "$f" ] || f="/System/Library/Sounds/$s.aiff"
    (/usr/bin/afplay "$f" >/dev/null 2>&1 &)
  elif command -v paplay >/dev/null 2>&1; then
    (paplay "$s" >/dev/null 2>&1 &)
  fi
}

notify() { # notify <state> <window>
  [ "$(opt @agent_signal_notify off)" = on ] || return 0
  title="Agent $1"
  body=$(t display -p -t "$2" '#{session_name}:#{window_index} #{window_name}')
  if command -v terminal-notifier >/dev/null 2>&1; then
    (terminal-notifier -title "$title" -message "$body" >/dev/null 2>&1 &)
  elif command -v osascript >/dev/null 2>&1; then
    (osascript -e "display notification \"$body\" with title \"$title\"" >/dev/null 2>&1 &)
  elif command -v notify-send >/dev/null 2>&1; then
    (notify-send "$title" "$body" >/dev/null 2>&1 &)
  fi
}

# Your own alert: @agent_signal_alert_command runs in the background on a state
# transition (never on a repeat of the same state). tmux formats in it are
# expanded against the window; the shell sees AGENT_SIGNAL_STATE,
# AGENT_SIGNAL_PREV, AGENT_SIGNAL_WINDOW and AGENT_SIGNAL_PANE.
alert_command() { # alert_command <state> <prev> <window> <pane>
  cmd=$(opt @agent_signal_alert_command "")
  [ -n "$cmd" ] || return 0
  case " $(opt_set @agent_signal_alert_states "blocked ask done") " in *" $1 "*) ;; *) return 0 ;; esac
  # display-message runs strftime over its output, so protect literal % signs.
  expanded=$(t display -p -t "$3" "$(printf '%s' "$cmd" | sed 's/%/%%/g')")
  (AGENT_SIGNAL_STATE=$1 AGENT_SIGNAL_PREV=$2 AGENT_SIGNAL_WINDOW=$3 AGENT_SIGNAL_PANE=$4 \
     sh -c "$expanded" >/dev/null 2>&1 </dev/null &)
}

bell() { # bell <pane>: ring tmux's own bell in that pane (monitor-bell, SSH-safe)
  [ "$(opt @agent_signal_bell off)" = on ] || return 0
  tty=$(t display -p -t "$1" '#{pane_tty}')
  [ -w "$tty" ] && printf '\a' > "$tty"
}

# --- state -----------------------------------------------------------------
# One look, not a theme: the badge glyph says which kind of attention a window
# wants, the tab colour says how urgently. Working and the holds are quiet.
style_for() { # style_for <state|hold> -> "icon fg bg"
  case $1 in
    working) printf '%s' "~ colour245 default" ;;
    blocked) printf '%s' "! black colour208" ;;
    ask)     printf '%s' "? black colour213" ;;
    done)    printf '%s' "✓ black green" ;;
    wait)    printf '%s' "… colour245 default" ;;
    park)    printf '%s' "p colour240 default" ;;
    *)       printf '' ;;
  esac
}

needs_you() { case $1 in blocked|ask) return 0 ;; *) return 1 ;; esac; }

# Only ever unset a window-status-style that we set ourselves: a theme or the
# user may have styled that window, and @agent_tab_owned records that the
# current value is ours.
restore_tab() { # restore_tab <window>
  if [ "$(t show-option -wqv -t "$1" @agent_tab_owned)" = 1 ]; then
    saved=$(t show-option -wqv -t "$1" @agent_tab_saved)
    if [ -n "$saved" ]; then t set-option -w -t "$1" window-status-style "$saved"; else t set-option -uw -t "$1" window-status-style; fi
    t set-option -uw -t "$1" @agent_tab_owned \; set-option -uw -t "$1" @agent_tab_saved
  fi
}

paint_window() { # paint_window <window> <state-or-hold>
  set -- "$1" "$(style_for "$2")" "$2"
  icon=""; fg=""; style=""
  if [ -n "$2" ]; then
    icon=${2%% *}; rest=${2#* }; fg=${rest%% *}; bg=${rest#* }
    # @agent_signal_tab_colour: all (every state with a bg), needs (only when a
    # window needs you), off (badge only). "on" is kept as an alias of all.
    colour_tab=1
    case $(opt @agent_signal_tab_colour all) in
      off) colour_tab=0 ;;
      needs) needs_you "$3" || colour_tab=0 ;;
    esac
    [ "$bg" = default ] || [ "$colour_tab" = 0 ] || style="fg=$fg,bg=$bg,bold"
  fi
  # What the tab shows now. tmux repaints every client on every option write,
  # even of the value already there, so only what differs is written: an event
  # that changes nothing (a tool call while already working) writes nothing.
  IFS='	' read -r ci cf co cs <<EOF2
$(t display -p -t "$1" '#{?@agent_icon,#{@agent_icon},-}	#{?@agent_fg,#{@agent_fg},-}	#{?@agent_tab_owned,1,-}	#{window-status-style}')
EOF2
  [ "$ci" = - ] && ci=""; [ "$cf" = - ] && cf=""
  if [ "$ci" != "$icon" ] || [ "$cf" != "$fg" ]; then
    if [ -n "$icon" ]; then t set-option -w -t "$1" @agent_icon "$icon" \; set-option -w -t "$1" @agent_fg "$fg"
    else t set-option -uw -t "$1" @agent_icon \; set-option -uw -t "$1" @agent_fg; fi
  fi
  if [ -z "$style" ]; then
    [ "$co" != 1 ] || restore_tab "$1"
  elif [ "$co" != 1 ] || [ "$cs" != "$style" ]; then
    # Taking the tab over: remember the style that was there so it comes back.
    if [ "$co" != 1 ]; then
      cur=$(t show-option -wqv -t "$1" window-status-style)
      if [ -n "$cur" ]; then t set-option -w -t "$1" @agent_tab_saved "$cur"; else t set-option -uw -t "$1" @agent_tab_saved; fi
    fi
    t set-option -w -t "$1" window-status-style "$style" \; set-option -w -t "$1" @agent_tab_owned 1
  fi
}

# Claude runs hooks concurrently, and refreshing a window is a read-modify-write
# across many tmux calls. A per-window mkdir lock keeps two hooks for panes in
# the same window from overwriting each other's result.
# Window ids repeat across tmux servers, so the lock is keyed on the server's
# socket path as well, with its slashes swapped for underscores in plain shell
# so the hook needs no cksum or cut on PATH.
lock_path() { # lock_path <window>
  key=${TMUX%%,*}; flat=
  while :; do
    case $key in */*) flat="$flat${key%%/*}_"; key=${key#*/} ;; *) flat="$flat$key"; break ;; esac
  done
  printf '%s/agent-signal.%s.lock.%s.%s' "${TMPDIR:-/tmp}" "$(id -u)" "$flat" "${1#@}"
}
lock_window() { # lock_window <window>
  LOCK=$(lock_path "$1")
  i=0
  until mkdir "$LOCK" 2>/dev/null; do
    i=$((i + 1))
    [ "$i" -gt 100 ] && { rmdir "$LOCK" 2>/dev/null; continue; }   # stale lock (killed holder): reclaim
    sleep 0.02
  done
  trap 'rmdir "$LOCK" 2>/dev/null' EXIT INT TERM
}
unlock_window() { rmdir "${LOCK:-/nonexistent}" 2>/dev/null; trap - EXIT INT TERM; }

clear_done_panes() { # clear_done_panes <window>: acknowledge every done pane
  t list-panes -t "$1" -F '#{pane_id}	#{@agent_pane_state}' | while IFS='	' read -r p st; do
    [ "$st" = done ] && t set-option -up -t "$p" @agent_pane_state
  done
}

# The badge sits in front of the window name so it reads as part of that tab:
# "!3:web". The plugin owns the window formats: tmux's own flag (* - # !) is
# dropped while a badge is showing, since the current tab is already styled
# and a flag after the name hid the badge's meaning.
BADGE='#{?#{@agent_icon},#[fg=#{@agent_fg}#,bold]#{@agent_icon}#[default],}'
WINDOW_FORMAT="${BADGE}#I:#W#{?#{@agent_icon},,#{?window_flags,#{window_flags}, }}"

# Pane borders: appended to pane-border-style and pane-active-border-style, so
# in a split window the pane that needs you has an orange (blocked), pink
# (ask) or green (done) border. A later attribute overrides an earlier one in
# a style, and "#," is a literal comma inside a conditional, so the user's own
# style stays in front as the base and nothing is added for other states.
BORDER_SUFFIX='#{?#{==:#{@agent_pane_state},blocked},#,fg=colour208,}#{?#{==:#{@agent_pane_state},ask},#,fg=colour213,}#{?#{==:#{@agent_pane_state},done},#,fg=green,}'

# A theme that sets window-status-format per window outranks the global one
# and hides the badge on that window. Put it in front of the window's own value.
mend_window_format() { # mend_window_format <window>
  for o in window-status-format window-status-current-format; do
    cur=$(t show-option -wqv -t "$1" "$o")
    [ -n "$cur" ] || continue
    case $cur in *@agent_icon*) ;; *) t set-option -w -t "$1" "$o" "${BADGE}${cur}" ;; esac
  done
}

refresh_window() { # refresh_window <window> [event]
  win=$1; ev=${2:-}
  mend_window_format "$win"
  # One round trip for the window's previous state and hold.
  # "-" placeholders: an empty first field would be dropped by read (a tab is
  # IFS whitespace) and the hold would land in prev.
  IFS='	' read -r prev hold <<EOF2
$(t display -p -t "$win" '#{?@agent_state,#{@agent_state},-}	#{?@agent_hold,#{@agent_hold},-}')
EOF2
  [ "$prev" = - ] && prev=""; [ "$hold" = - ] && hold=""
  agg=""
  # One round trip for every pane's state.
  for st in $(t list-panes -t "$win" -F '#{?@agent_pane_state,#{@agent_pane_state},-}'); do
    case $st in
      blocked) agg=blocked ;;
      ask)     [ "$agg" != blocked ] && agg=ask ;;
      done)    needs_you "$agg" || agg=done ;;
      working) [ -z "$agg" ] && agg=working ;;
    esac
  done

  # Something new happened -> a "wait" hold has served its purpose.
  if [ "$hold" = wait ] && [ -n "$ev" ] && [ "$agg" != "$prev" ]; then
    hold=""; t set-option -uw -t "$win" @agent_hold
  fi

  # Finished while you were already looking at it -> nothing to flag.
  if [ "$agg" = done ] && [ -n "$ev" ] && visible "$win"; then
    clear_done_panes "$win"
    agg=""
  fi

  # Written only when the state changes, with a stamp, so `next` can serve the
  # longest wait first.
  if [ "$agg" != "$prev" ]; then
    if [ -n "$agg" ]; then t set-option -w -t "$win" @agent_state "$agg" \; set-option -w -t "$win" @agent_since "$(date +%s)"
    else t set-option -uw -t "$win" @agent_state \; set-option -uw -t "$win" @agent_since; fi
  fi

  if [ -n "$hold" ] && ! needs_you "$agg"; then paint_window "$win" "$hold"; else paint_window "$win" "$agg"; fi

  if [ -n "$ev" ] && [ "$agg" != "$prev" ] && [ -z "$hold" ]; then
    case $agg in blocked|ask|done)
      visible "$win" || { play "$agg"; notify "$agg" "$win"; }
      alert_command "$agg" "$prev" "$win" "${EVENT_PANE:-}" ;;
    esac
  fi
  refresh_needs
  refresh_progress
}

refresh_needs() { # count of windows needing you (blocked or ask), for titles and your own status line
  # Dead panes (remain-on-exit) are skipped so a crashed agent does not linger.
  # The count already published comes back on the same listing, and is only
  # rewritten when it is wrong.
  # shellcheck disable=SC2046  # two numbers, split on purpose
  set -- $(t list-panes -a -F '#{window_id}	#{?@agent_pane_state,#{@agent_pane_state},-}	#{pane_dead}	#{?@agent_needs,#{@agent_needs},0}' \
    | awk -F'	' '{ cur = $4 } $3 != "1" && ($2 == "blocked" || $2 == "ask") && !seen[$1]++ { n++ } END { print n + 0, cur + 0 }')
  [ "${1:-0}" != "${2:-0}" ] || return 0
  if [ "${1:-0}" -gt 0 ]; then t set-option -g @agent_needs "$1"; else t set-option -gu @agent_needs; fi
}

# --- terminal progress bar (OSC 9;4) ----------------------------------------
# iTerm2 3.6+, WezTerm and Ghostty draw a bar along the top of a tab from
# OSC 9;4. The bar belongs to the terminal tab, so every pane on screen shares
# one: the plugin writes a single value per client, worked out from the panes
# of the window that client shows (@agent_signal_progress window) or of every
# window (server). Only a client whose terminal named itself to tmux's version
# query (#{client_termtype}, tmux 3.3+) in @agent_signal_progress_terminals
# gets it: an older terminal may read OSC 9 as a desktop notification, and one
# that does not know it at all may print it. Anything else gets nothing.
PROGRESS_TERMINALS='^(iTerm2 (3\.([6-9]|[1-9][0-9])|[4-9])|WezTerm|ghostty)'

progress_value() { # progress_value <window|""> -> "state;percent" for OSC 9;4
  # blocked: error (red), ask: warning (yellow), working: green, filled by the
  # share of agent panes that have finished, or moving while none has;
  # done but unseen: full green; nothing to say: cleared.
  if [ -n "$1" ]; then set -- -t "$1"; else set -- -a; fi
  t list-panes "$@" -F '#{?@agent_pane_state,#{@agent_pane_state},-}	#{?@agent_kind,1,-}	#{pane_dead}' |
    awk -F'	' '$3 == "1" || ($1 == "-" && $2 == "-") { next }
      { n++; c[$1]++ }
      END {
        if (c["blocked"]) print "2;100"; else if (c["ask"]) print "4;100"
        else if (c["working"] && c["working"] == n) print "3;0"
        else if (c["working"]) printf "1;%d\n", (n - c["working"]) * 100 / n
        else if (c["done"]) print "1;100"; else print "0;0"
      }'
}

refresh_progress() { # refresh_progress [print|clear]: print lists "tty<TAB>value" instead of writing
  scope=$(opt @agent_signal_progress window)
  [ "$scope" != off ] || [ "${1:-}" = clear ] || return 0
  terms=$(opt @agent_signal_progress_terminals "$PROGRESS_TERMINALS")
  all=""; [ "$scope" = server ] && [ "${1:-}" != clear ] && all=$(progress_value "")
  t list-clients -F '#{client_tty}	#{window_id}	#{client_termtype}' |
    while IFS='	' read -r tty win type; do
      printf '%s\n' "$type" | grep -Eq -- "$terms" || continue
      case ${1:-} in clear) val="0;0" ;; *) val=${all:-$(progress_value "$win")} ;; esac
      if [ "${1:-}" = print ]; then printf '%s\t%s\n' "$tty" "$val"
      # ESC ] 9 ; 4 ; state ; percent BEL. A tty that has gone away fails quietly.
      else { printf '\033]9;4;%s\007' "$val" >"$tty"; } 2>/dev/null; fi
    done
  return 0
}

# --- usage limits (opt-in: @agent_signal_limits on) --------------------------
# How much of each agent's subscription allowance is used, from what the
# agents already hand over: Claude Code's statusLine JSON and the tail of
# Codex's newest rollout log. No network, no credentials, no timer: a window
# is recorded when its agent reports, and @agent_limits is rebuilt on every
# agent event, so pace and staleness only move when something happens.
limits_on() { [ "$(opt @agent_signal_limits off)" = on ]; }

limit_window() { # limit_window <agent> <json-key> [5h|7d]: record the window at "key" of rate_limits in $JSON
  if command -v jq >/dev/null 2>&1; then
    lf=$(printf '%s' "$JSON" | jq -r --arg k "$2" '[.. | .rate_limits? | objects | .[$k] | objects] | last // empty
      | "\(.used_percentage // .used_percent // "-") \(.resets_at // "-") \(.window_minutes // "-") \(.resets_in_seconds // "-")"' 2>/dev/null)
  else
    # The first "key" once rate_limits has opened. A window is a flat object,
    # so its body runs to the first closing brace.
    lo=$(printf '%s' "$JSON" | tr -d '\n' | sed -n 's/.*"rate_limits"[[:space:]]*:[[:space:]]*{//p' | grep -o "\"$2\"[[:space:]]*:[[:space:]]*{[^{}]*}" | head -1)
    lf=$(for lk in 'used_percent[a-z]*' resets_at window_minutes resets_in_seconds; do
      ln=$(printf '%s' "$lo" | sed -n "s/.*\"$lk\"[[:space:]]*:[[:space:]]*\([0-9][0-9.]*\).*/\1/p"); printf '%s ' "${ln:--}"; done)
  fi
  IFS=' ' read -r used reset mins secs <<EOF2
$lf
EOF2
  # Codex names its windows by position, which moves (a plan may have only a
  # weekly or a monthly one), so the length decides which window this is,
  # give or take a few minutes of rounding.
  lw=${3:-}; case ${mins%%.*} in 29[5-9]|30[0-5]) lw=5h ;; 100[78][0-9]|10090) lw=7d ;; esac
  used=${used%%.*}; reset=${reset%%.*}; secs=${secs%%.*}
  case $used in ''|*[!0-9]*) return 0 ;; esac
  [ -n "$lw" ] || return 0
  case $reset in ''|*[!0-9]*) case $secs in ''|*[!0-9]*) reset="" ;; *) reset=$((NOW + secs)) ;; esac ;; esac
  # A window that has already reset says nothing about the one running now (an
  # idle session can still be holding it).
  [ -z "$reset" ] || [ "$reset" -gt "$NOW" ] || return 0
  lp="@agent_limit_${1}_${lw}"; la="@agent_limit_${1}_at"
  # What is stored, in one round trip: $1 its reset, $2 its used, $3 when.
  # shellcheck disable=SC2046  # three numbers, split on purpose
  set -- $(t show-options -g 2>/dev/null | awk -v p="$lp" -v a="$la" '
    $1 == p "_reset" { r = $2 } $1 == p "_used" { u = $2 } $1 == a { s = $2 } END { print r + 0, u + 0, s + 0 }')
  # The agent's windows share one record time, so it is taken once, before
  # either is written: the second must not find the first one's fresh stamp.
  [ -n "$LIMIT_AT" ] || LIMIT_AT=$3
  # A report that names no reset belongs to the stored window while that one is still to come.
  [ -n "$reset" ] || [ "$1" -le "$NOW" ] || reset=$1
  # A session reports what it last saw, so an idle one can be behind the
  # others. For ten minutes after a record, an earlier window does not replace
  # it, and the same window (resets within a minute) only with as much used or
  # more. After that anything is taken: a real drop must not stick.
  if [ -n "$reset" ] && [ $((NOW - LIMIT_AT)) -lt 600 ]; then
    [ "$reset" -ge $(($1 - 60)) ] || return 0
    [ "$reset" -gt $(($1 + 60)) ] || [ "$used" -ge "$2" ] || return 0
  fi
  [ "$used" -le 100 ] || used=100
  # Nothing new since a record under five minutes old: no write. Every option
  # write makes tmux repaint every client, and this runs on each status line
  # update of every Claude session.
  if [ "$used" = "$2" ] && [ "${reset:-0}" = "$1" ] && [ $((NOW - LIMIT_AT)) -lt 300 ]; then return 0; fi
  # One tmux command, so another session never sees half a record.
  if [ -n "$reset" ]; then set -- set-option -g "${lp}_reset" "$reset"; else set -- set-option -gu "${lp}_reset"; fi
  t set-option -g "${lp}_used" "$used" \; set-option -g "$la" "$NOW" \; "$@"
}

limits_codex() { # the last rate_limits record in the tail of the newest rollout log
  ld="${CODEX_HOME:-$HOME/.codex}/sessions"; [ -d "$ld" ] || return 0
  # (The trailing slash makes find follow a sessions directory that is a symlink.)
  lf=$(find "$ld/" -name 'rollout-*.jsonl' -mtime -1 -exec ls -t {} + 2>/dev/null | head -1)
  [ -n "$lf" ] || return 0
  # Codex may meter some models apart and report each under its own limit_id.
  # The main allowance is the one called "codex", or with no id at all; only
  # when the tail holds none of those is the last record of any kind used.
  JSON=$(tail -n 100 "$lf" | awk '/"rate_limits"[[:space:]]*:[[:space:]]*[{]/ { any = $0
      if ($0 !~ /"limit_id"[[:space:]]*:[[:space:]]*"/ || $0 ~ /"limit_id"[[:space:]]*:[[:space:]]*"codex"/) main = $0 }
    END { print (main != "" ? main : any) }')
  [ -n "$JSON" ] || return 0
  limit_window codex primary; limit_window codex secondary
}

# The figure is what is left of the 5-hour window ("C 62%"), plus the weekly
# one ("w30%") when that is tighter or the only one known. Plain while on
# pace; orange at 90% used or when what is left trails an even burn-down of
# the window by more than @agent_signal_limits_pace points; red at 100%. A
# window whose reset has passed is dropped, and an agent not heard from for
# six hours is dimmed.
limits_clear() { for o in $(t show-options -g | sed -n 's/^\(@agent_limit[a-z0-9_]*\) .*/\1/p'); do t set-option -gu "$o"; done; }

limits() { # limits [claude|codex]: record that agent's windows, then rebuild @agent_limits
  limits_on || return 0
  NOW=${AGENT_SIGNAL_NOW:-$(date +%s)}; LIMIT_AT=""
  case ${1:-} in
    claude) limit_window claude five_hour 5h; limit_window claude seven_day 7d ;;
    codex)  limits_codex ;;
  esac
  # The figure in force comes back on the same round trip (the "=" line), and
  # the answer is "=" when it is still right: then nothing is written.
  out=$(t show-options -g \; display-message -p '=#{@agent_limits}' | awk -v now="$NOW" '
    function window(k, len,    used, reset) { # sets lvl (0 nothing to show, 1 plain, 2 orange, 3 red), left, plain, txt
      lvl = 0; if (!((k "_used") in v)) return
      used = v[k "_used"] + 0; reset = v[k "_reset"]
      if (reset != "" && reset + 0 <= now) return
      left = 100 - used; plain = (show == "used" ? used : left) "%"
      lvl = used >= 100 ? 3 : (used >= 90 || (pace > 0 && reset != "" && 100 * (reset - now) / len - left > pace)) ? 2 : 1
      txt = lvl > 1 ? "#[fg=" (lvl == 3 ? "red" : "colour208") "]" plain "#[default]" : plain
    }
    BEGIN { pace = 10 }
    /^=/ { cur = substr($0, 2); next }
    $1 ~ /^@agent_limit_/ { v[substr($1, 14)] = $2 }
    $1 == "@agent_signal_limits_show" { show = $2 }
    $1 == "@agent_signal_limits_pace" { pace = $2 + 0 }
    END {
      n = split("claude C codex X", a, " ")
      for (i = 1; i < n; i += 2) {
        window(a[i] "_5h", 18000); l5 = lvl; left5 = left; s = p = ""
        if (lvl) { s = " " txt; p = " " plain }
        window(a[i] "_7d", 604800)
        if (lvl && (!l5 || left < left5 || lvl > l5)) { s = s " w" txt; p = p " w" plain }
        if (s == "") continue
        if (now - v[a[i] "_at"] > 21600) s = "#[fg=colour245]" a[i + 1] p "#[default]"; else s = a[i + 1] s
        out = out (out == "" ? "" : " ") s
      }
      print (out == cur ? "=" : "!" out)
    }')
  case $out in
    "="|"") ;;                                # still right, or tmux did not answer
    "!") t set-option -gu @agent_limits ;;
    *)   t set-option -g @agent_limits "${out#!}" ;;
  esac
}

# --- Claude Code statusLine entry ---------------------------------------------
# Claude pipes its status JSON here. The usage windows in it are recorded in
# the background, so the status line never waits for that, and the command
# that was the status line before us (the argument the installer wrote, else
# @agent_signal_statusline_next) gets the same stdin and decides what is
# printed and the exit status. Without one, nothing is printed.
statusline() { # statusline [command]
  JSON=$(cat 2>/dev/null; printf x); JSON=${JSON%x}   # $(cat) alone would drop the trailing newline
  # exec, not a redirection on the call: dash keeps a copy of the old stdout
  # for the length of a redirected function call, and Claude would wait on it.
  [ -z "${TMUX:-}" ] || (exec >/dev/null 2>&1; limits claude &)
  next=${1:-}
  [ -n "$next" ] || [ -z "${TMUX:-}" ] || next=$(opt @agent_signal_statusline_next "")
  [ -n "$next" ] || return 0
  # (A command that reads no stdin closes the pipe on us; that is not an error.)
  printf '%s' "$JSON" 2>/dev/null | sh -c "$next"
}

# A hook can fire before tmux has sourced the entry file (plugin installed,
# tmux not yet reloaded). Wire the server up on the spot rather than dropping
# the event; the entry file is idempotent, so a later reload changes nothing.
bootstrap_if_needed() {
  case $(t show-option -gqv window-status-format) in *@agent_icon*) ;; *) sh "$PLUGIN_DIR/agent-signal.tmux" >/dev/null 2>&1 ;; esac
}

set_state() { # set_state <state> [pane]
  bootstrap_if_needed
  pane=$(resolve_pane "${2:-}"); EVENT_PANE=$pane
  win=$(window_of "$pane") || exit 0
  lock_window "$win"
  case $1 in
    working|blocked|ask|done) want=$1 ;;
    idle|clear|"")        want="" ;;
    *) echo "agent-signal: unknown state '$1'" >&2; exit 1 ;;
  esac
  # What the pane says now (read under the lock), so that only what differs is
  # written: see paint_window.
  IFS='	' read -r cst ck cn <<EOF2
$(t display -p -t "$pane" '#{?@agent_pane_state,#{@agent_pane_state},-}	#{?@agent_kind,#{@agent_kind},-}	#{?@agent_name,1,-}')
EOF2
  [ "$cst" = - ] && cst=""
  if [ "$want" != "$cst" ]; then
    if [ -n "$want" ]; then t set-option -p -t "$pane" @agent_pane_state "$want"; else t set-option -up -t "$pane" @agent_pane_state; fi
  fi
  if [ "$1" = clear ]; then
    [ "$ck$cn" = -- ] || t set-option -up -t "$pane" @agent_kind \; set-option -up -t "$pane" @agent_name
  else
    [ "$ck" = "${AGENT_KIND:-agent}" ] || t set-option -p -t "$pane" @agent_kind "${AGENT_KIND:-agent}"
  fi
  needs_you "$1" && bell "$pane"
  refresh_window "$win" event
  unlock_window
  # Codex has no status line to report through: its log is read as a turn ends.
  if [ "${AGENT_KIND:-}" = codex ] && [ "$1" = done ]; then limits codex; else limits; fi
}

# --- Claude Code hook mapping ---------------------------------------------
hook() {
  # A Claude background job (/bg, scheduled work) runs its hooks from the same
  # pane environment as the interactive session and would overwrite its state.
  [ -z "${CLAUDE_JOB_DIR:-}" ] || return 0
  JSON=$(cat 2>/dev/null || true)
  AGENT_KIND=claude
  case $1 in
    SessionStart)
      # Auto-compaction mid-turn also fires SessionStart (source "compact");
      # the agent is still working, so nothing about the pane has changed.
      case $(json_get '.source' source) in compact) ;; *) set_state idle; sync_registry ;; esac ;;
    UserPromptSubmit|PostToolUse) set_state working ;;
    PreToolUse)
      case $(json_get '.tool_name' tool_name) in
        # A question is a tool call that waits on you. Plan approval is not
        # listed: it arrives as a PermissionRequest like any other prompt, and
        # mapping it here too would flag (and sound) the same wait twice.
        AskUserQuestion) set_state ask ;;
        *) set_state working ;;
      esac ;;
    PermissionRequest) set_state blocked ;;
    Notification)
      case $(json_get '.notification_type' notification_type) in
        permission_prompt) set_state blocked ;;
        elicitation*|agent_needs_input) set_state ask ;;
        idle_prompt)
          # Fires ~60s after any finish. Only a pane still marked working needs
          # rescuing (turn ended without a Stop, e.g. Esc); otherwise leave it.
          if [ "$(pane_state "$(resolve_pane)")" = working ]; then set_state done; fi ;;
      esac ;;
    Stop|StopFailure)
      if json_array_nonempty '.background_tasks' background_tasks; then set_state working; else set_state done; fi ;;
    SessionEnd)        set_state clear ;;
  esac
}

# --- Claude session registry (names, presence) -----------------------------
sync_registry() {
  dir="$HOME/.claude/sessions"; [ -d "$dir" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  for f in "$dir"/*.json; do
    [ -f "$f" ] || continue
    jq -r 'select(.tmux != null and .tmux != "") | "\(.tmux)\t\(.name // "-")"' "$f" 2>/dev/null \
    | { IFS='	' read -r tm name || exit 0
        pane="%${tm##*.%}"
        # The registry names session:window.pane; require all three to match so a
        # stale entry, or another server reusing the same pane number, is ignored.
        loc=$(t display -p -t "$pane" '#{session_name}:#{window_id}.#{pane_id}' 2>/dev/null) || exit 0
        [ "$loc" = "$tm" ] || exit 0
        [ -n "$name" ] && [ "$name" != - ] && t set-option -p -t "$pane" @agent_name "$name"
        t set-option -p -t "$pane" @agent_kind claude; }
  done
  refresh_needs
}

# --- navigation & triage ---------------------------------------------------
current_window() { t display -p '#{window_id}'; }

seen() { # seen [window]: the hook passes its own window so a second attached client is never confused
  win=${1:-$(current_window)}
  # Every view moves the bar to the window now on screen, done or not.
  [ "$(t show-option -wqv -t "$win" @agent_state)" = done ] || { refresh_progress; return 0; }
  lock_window "$win"
  clear_done_panes "$win"
  refresh_window "$win"
  unlock_window
}

next() {
  cur=$(current_window)
  # Tab separated, session *id* rather than name: names may contain spaces.
  list=$(t list-windows -a -F '#{window_id}	#{session_id}	#{?@agent_state,#{@agent_state},-}	#{?@agent_hold,#{@agent_hold},-}	#{?@agent_since,#{@agent_since},0}')
  for want in blocked ask done; do
    # The tier's windows, longest wait first (window order breaks ties). If the
    # current window is in that list, continue from the one after it, wrapping,
    # so repeated presses walk every window rather than bouncing between the
    # two oldest. Otherwise start from the oldest.
    tier=$(printf '%s\n' "$list" | awk -F'	' -v w="$want" '$3==w && $4=="-" {print $5"\t"NR"\t"$1"\t"$2}' | sort -n -k1,1 -k2,2 | cut -f3,4)
    [ -n "$tier" ] || continue
    after=$(printf '%s\n' "$tier" | sed -n "/^$cur	/,\$p" | sed '1d')
    before=$(printf '%s\n' "$tier" | sed "/^$cur	/,\$d")
    target=$(printf '%s\n%s\n' "$after" "$before" | sed -n '/./{p;q;}')
    t switch-client -t "${target#*	}" 2>/dev/null
    t select-window -t "${target%%	*}"
    # In a split window, land in the pane that needs you (the most urgent,
    # by pane order), not wherever the cursor last was.
    pane=$(t list-panes -t "${target%%	*}" -F '#{pane_id}	#{?@agent_pane_state,#{@agent_pane_state},-}' \
      | awk -F'	' -v w="$want" '$2==w {print $1; exit}')
    [ -n "$pane" ] && t select-pane -t "$pane"
    return 0
  done
  t display-message "agent-signal: nothing needs you"
}

hold() { # hold wait|park|clear [window]
  win=${2:-$(current_window)}
  lock_window "$win"
  cur=$(t show-option -wqv -t "$win" @agent_hold)
  case $1 in
    clear) t set-option -uw -t "$win" @agent_hold ;;
    wait|park)
      if [ "$cur" = "$1" ]; then t set-option -uw -t "$win" @agent_hold
      else t set-option -w -t "$win" @agent_hold "$1"; fi ;;
  esac
  refresh_window "$win"
  unlock_window
}

# --- listing for the switcher ---------------------------------------------
# kind<TAB>target<TAB>display
list() {
  sync_registry
  t list-sessions -F '#{session_name}' | while read -r s; do
    sstate=$(t list-windows -t "$s" -F '#{@agent_state}' | awk '/blocked/{b=1} /ask/{a=1} /done/{d=1} /working/{w=1} END{if(b)print "!";else if(a)print "?";else if(d)print "+";else if(w)print "~"}')
    printf 'S\t%s\t%s %s\n' "$s" "${sstate:- }" "$s"
    # tab-separated; empty fields are sent as "-" because `read` collapses runs of tabs
    t list-windows -t "$s" -F '#{window_id}	#{window_index}	#{?window_name,#{window_name},-}	#{?@agent_state,#{@agent_state},-}	#{?@agent_hold,#{@agent_hold},-}	#{window_panes}' \
    | while IFS='	' read -r wid idx name st hd np; do
        [ "$name" = - ] && name=""; [ "$st" = - ] && st=""; [ "$hd" = - ] && hd=""
        mark=$(style_for "${hd:-$st}"); mark=${mark%% *}
        # icons are multibyte, so pad with a literal rather than %-2s (which counts bytes)
        printf 'W\t%s\t%s    %s:%s%s\n' "$wid" "${mark:- }" "$idx" "$name" "${hd:+ ($hd)}"
        [ "$np" -gt 1 ] || [ -n "$st" ] || continue
        t list-panes -t "$wid" -F '#{pane_id}	#{pane_index}	#{?pane_current_command,#{pane_current_command},-}' \
        | while IFS='	' read -r pid pidx pc; do
            pst=$(pane_state "$pid"); pk=$(pane_opt "$pid" @agent_kind); pn=$(pane_opt "$pid" @agent_name)
            m=$(style_for "$pst"); m=${m%% *}
            printf 'P\t%s\t%s       %s: %s\n' "$pid" "${m:- }" "$pidx" "${pn:-${pk:-$pc}}"
          done
      done
  done
}

# --- installer -------------------------------------------------------------
install_claude_hooks() {
  settings="$HOME/.claude/settings.json"
  command -v jq >/dev/null 2>&1 || { echo "jq is required to merge hooks; see docs/claude-hooks.json for a manual copy" >&2; exit 1; }
  [ -f "$settings" ] || { mkdir -p "$(dirname "$settings")" && printf '{}\n' > "$settings"; }
  # Keep the first backup: it is the only copy of the settings as they were before us.
  [ -f "$settings.bak-agent-signal" ] || cp "$settings" "$settings.bak-agent-signal"
  # The path is double-quoted inside the command because Claude runs hooks
  # through a shell and a plugin directory may contain spaces.
  # shellcheck disable=SC2016  # $ev and $bin are jq's variables
  settings_edit --arg bin "$SELF" '
    def matcher($ev): if $ev == "SessionStart" then "startup|resume|clear|fork" else "" end;
    def entry($ev): {matcher: matcher($ev), hooks: [{type: "command", command: ("\"" + $bin + "\" hook " + $ev), async: true}]};
    def add($ev): .hooks[$ev] = ((.hooks[$ev] // []) | map(select((.hooks // []) | any(.command | tostring | contains("agent-signal\" hook") or contains("agent-signal hook")) | not)) + [entry($ev)]);
    .hooks //= {} |
    reduce ("SessionStart","UserPromptSubmit","PreToolUse","PostToolUse","PermissionRequest","Notification","Stop","StopFailure","SessionEnd") as $ev (.; add($ev))
  ' && echo "hooks merged into $settings (backup: $settings.bak-agent-signal)" && return 0
  echo "agent-signal: could not rewrite $settings; nothing changed" >&2; exit 1
}

# Rewrite $settings with a jq filter. The new content goes to a file beside
# the real one, which is then renamed over it, so the settings are never seen
# empty or half written. A settings.json that is a symlink into a dotfiles
# repo stays one (the link is followed first), and the mode is kept (cp -p
# gives the new file the old one's before its content is replaced). Nothing
# changes if jq fails.
settings_edit() { # settings_edit <jq arguments>
  real=$settings
  while [ -L "$real" ]; do
    l=$(readlink "$real") || return 1
    case $l in /*) real=$l ;; *) real=$(dirname "$real")/$l ;; esac
  done
  tmp=$(mktemp "$real.XXXXXX") || return 1
  trap 'rm -f "$tmp"' EXIT INT TERM
  if cp -p "$real" "$tmp" && jq "$@" "$real" > "$tmp" && [ -s "$tmp" ]; then mv "$tmp" "$real"; rc=$?; else rc=1; fi
  rm -f "$tmp"; return "$rc"
}

# Claude has one statusLine, so ours wraps whatever was there: the old command
# becomes the argument `statusline` chains to. What was there and what replaced
# it are both kept beside the settings file, so uninstall can put the first
# back and can tell whether the second has been edited since.
install_claude_statusline() {
  settings="$HOME/.claude/settings.json"; saved="$settings.statusline-agent-signal"
  command -v jq >/dev/null 2>&1 || { echo "jq is required to edit $settings; by hand, set statusLine.command to: \"$SELF\" statusline" >&2; exit 1; }
  [ -f "$settings" ] || { mkdir -p "$(dirname "$settings")" && printf '{}\n' > "$settings"; }
  restore_claude_statusline >/dev/null   # a re-run starts from the original (the plugin may have moved)
  adopt=0
  case $(jq -r '.statusLine.command // ""' "$settings" 2>/dev/null) in
    # Set by hand to the bare command, as the message above says to do without
    # jq: there was nothing before it that we know of, so take it over.
    *agent-signal\"" statusline"|*"agent-signal statusline") [ -f "$saved" ] || adopt=1 ;;
    *agent-signal*" statusline"*) ;;
    *) adopt=no ;;
  esac
  if [ "$adopt" = 0 ]; then
    if [ -f "$saved" ]; then why="is not as the installer left it"; else why="was set by hand with a command of its own"; fi
    echo "statusLine in $settings already runs agent-signal statusline and $why; nothing changed" >&2; exit 1
  fi
  # Worked out before anything is written: a settings.json that does not parse changes nothing.
  new=$(jq -c --arg bin "$SELF" --arg adopt "$adopt" '(if $adopt == "1" then null else .statusLine end) as $was
    | ($was.command // null) as $prev | {original: $was,
    installed: ((.statusLine // {}) + {type: "command", command: ("\"" + $bin + "\" statusline" + (if $prev then " " + ($prev | @sh) else "" end))})}' "$settings" 2>/dev/null)
  [ -n "$new" ] || { echo "agent-signal: $settings is not valid JSON; nothing changed" >&2; exit 1; }
  # shellcheck disable=SC2016  # $s is jq's variable
  printf '%s\n' "$new" > "$saved" && settings_edit --argjson s "$new" '.statusLine = $s.installed' \
    && echo "statusLine set in $settings (original kept in $saved)" && return 0
  echo "agent-signal: could not rewrite $settings; nothing changed" >&2; exit 1
}

restore_claude_statusline() { # put back the statusLine the installer replaced, unless it has been edited since
  settings="$HOME/.claude/settings.json"; saved="$settings.statusline-agent-signal"
  [ -f "$saved" ] || return 0
  command -v jq >/dev/null 2>&1 || { echo "agent-signal: jq not found, so statusLine in $settings is left as it is (the original is in $saved)"; return 0; }
  case $(jq -r '.statusLine.command // ""' "$settings" 2>/dev/null) in *agent-signal*" statusline"*) ;; *) return 0 ;; esac
  if [ "$(jq --slurpfile s "$saved" '.statusLine == $s[0].installed' "$settings" 2>/dev/null)" != true ]; then
    echo "agent-signal: statusLine in $settings has been edited since it was installed, so it is left as it is (the original is in $saved)"; return 0
  fi
  # shellcheck disable=SC2016  # $s is jq's variable
  settings_edit --slurpfile s "$saved" 'if $s[0].original == null then del(.statusLine) else .statusLine = $s[0].original end' \
    && rm -f "$saved" && echo "agent-signal: statusLine in $settings is back as it was"
}

# --- check -----------------------------------------------------------------
# What is wired, what is missing, and whether anything reports. Exits 1 if
# something the plugin relies on is not in place.
check() {
  bad=0
  say() { printf '  %-4s %s\n' "$1" "$2"; [ "$1" = fail ] && bad=1; return 0; }
  echo "agent-signal $(sed -n 's/^# agent-signal \([0-9.]*\):.*/\1/p' "$0") on tmux $(t display -p '#{version}')"
  if [ -n "${TMUX:-}" ]; then say ok "inside tmux ($TMUX_BIN)"; else say fail "TMUX is not set: run this from a pane"; fi
  if [ "$(t show-option -gqv @agent_signal_command)" = "$SELF" ]; then say ok "command path published"; else say fail "@agent_signal_command not published: source agent-signal.tmux"; fi
  case $(t show-option -gv window-status-format) in *@agent_icon*) say ok "badge in window-status-format" ;; *) say fail "badge missing from window-status-format" ;; esac
  case $(t show-option -gv pane-border-style) in *@agent_pane_state*) say ok "state colours in pane-border-style" ;; *) say warn "state colours not in pane-border-style" ;; esac
  # Pane hooks (pane-exited, pane-died) are stored at window scope.
  n=$( { t show-hooks -g; t show-hooks -gw; } 2>/dev/null | grep -c "agent-signal"); if [ "$n" -ge 8 ]; then say ok "$n hooks installed"; else say fail "only $n of 8 hooks installed"; fi
  for k in next switcher wait park; do
    case $k in next) d=N ;; switcher) d=A ;; wait) d=W ;; park) d=P ;; esac
    key=$(opt_set "@agent_signal_key_$k" "$d")
    [ -z "$key" ] && { say ok "$k binding switched off"; continue; }
    if t list-keys -T prefix | awk -v k="$key" '$4 == k' | grep -qE 'agent-signal|switcher'; then say ok "prefix+$key -> $k"; else say warn "prefix+$key is not ours ($k unbound)"; fi
  done
  themed=$(t list-windows -a -F '#{window_id}	#{?window-status-format,#{window-status-format},-}' | awk -F'	' '$2 != "-" && $2 !~ /@agent_icon/ {print $1}' | tr '\n' ' ')
  if [ -z "$themed" ]; then say ok "no window overrides its format without the badge"; else say warn "windows with an unmended format override: $themed (fixed on their next event)"; fi
  check_progress
  check_limits
  agents=$(t list-panes -a -F '#{?@agent_kind,1,}' | grep -c 1); say ok "$agents pane(s) report an agent"
  if command -v jq >/dev/null 2>&1; then say ok "jq found"; else say warn "jq not found (sed fallback for hooks; installer unavailable)"; fi
  if command -v fzf >/dev/null 2>&1; then say ok "fzf found"; else say warn "fzf not found (switcher unavailable)"; fi
  if [ -x /usr/bin/afplay ] || command -v paplay >/dev/null 2>&1; then say ok "sound player found"; else say warn "no sound player (afplay/paplay)"; fi
  return $bad
}

check_progress() { # the progress bar lines of check (uses check's say)
  [ "$(opt @agent_signal_progress window)" != off ] || { say ok "progress bar switched off"; return 0; }
  terms=$(opt @agent_signal_progress_terminals "$PROGRESS_TERMINALS")
  t list-clients -F '#{client_tty}	#{client_termtype}' | while IFS='	' read -r tty type; do
    if printf '%s\n' "$type" | grep -Eq -- "$terms"; then say ok "progress bar on $tty (${type})"
    else say ok "no progress bar on $tty (${type:-terminal did not say what it is}; not in @agent_signal_progress_terminals)"; fi
  done
  f="$HOME/.claude/settings.json"
  if command -v jq >/dev/null 2>&1 && [ -f "$f" ] && [ "$(jq -r '.terminalProgressBarEnabled' "$f" 2>/dev/null)" != false ]; then
    say warn "Claude Code draws its own progress bar too; set \"terminalProgressBarEnabled\": false in $f"
  fi
}

check_limits() { # the usage meter lines of check (uses check's say)
  limits_on || { say ok "usage meter switched off (@agent_signal_limits)"; return 0; }
  say ok "usage meter on: $(opt @agent_limits "nothing recorded yet" | sed 's/#\[[^]]*\]//g')"
  if grep -q 'agent-signal[\\"]* statusline' "$HOME/.claude/settings.json" 2>/dev/null; then say ok "Claude Code statusLine runs agent-signal statusline"
  else say warn "Claude Code statusLine does not run agent-signal statusline (install-claude-statusline)"; fi
  ld="${CODEX_HOME:-$HOME/.codex}/sessions"
  if [ -d "$ld" ]; then say ok "Codex rollout logs in $ld"; else say ok "no Codex rollout logs in $ld"; fi
}

# --- uninstall -------------------------------------------------------------
# The inverse of agent-signal.tmux plus a sweep of live windows and panes.
uninstall() {
  if [ -z "${TMUX:-}" ] || [ -z "$TMUX_BIN" ]; then
    restore_claude_statusline
    echo "agent-signal: not inside tmux, so the server was left alone. Run uninstall from a pane to remove formats, hooks and key bindings."
    return 0
  fi
  refresh_progress clear
  # The window formats and border styles go back to what the entry file found.
  for o in window-status-format window-status-current-format pane-border-style pane-active-border-style; do
    case $(t show-option -gqv "$o") in *@agent_icon*|*@agent_pane_state*)
      saved=$(t show-option -gqv "@agent_saved_$o")
      if [ -n "$saved" ]; then t set-option -g "$o" "$saved"; else t set-option -gu "$o"; fi ;;
    esac
    t set-option -gu "@agent_saved_$o"
  done
  for h in after-select-window client-session-changed client-attached client-focus-in pane-exited pane-died after-kill-pane window-unlinked; do
    t set-hook -gu "${h}[91]" 2>/dev/null
  done
  # The outer-terminal title, if the entry file turned it on.
  saved=$(t show-option -gqv @agent_title_saved)
  if [ -n "$saved" ]; then
    t set-option -g set-titles "${saved%% *}"
    t set-option -g set-titles-string "${saved#* }"
    t set-option -gu @agent_title_saved
  fi
  for k in "$(opt_set @agent_signal_key_next N)" "$(opt_set @agent_signal_key_switcher A)" "$(opt_set @agent_signal_key_wait W)" "$(opt_set @agent_signal_key_park P)"; do
    [ -n "$k" ] && t list-keys -T prefix | awk -v k="$k" '$4 == k' | grep -q agent-signal && t unbind-key -T prefix "$k"
  done
  for w in $(t list-windows -a -F '#{window_id}'); do
    restore_tab "$w"
    # A badge woven into a per-window format by mend_window_format.
    for o in window-status-format window-status-current-format; do
      cur=$(t show-option -wqv -t "$w" "$o")
      case $cur in "$BADGE"*) t set-option -w -t "$w" "$o" "${cur#"$BADGE"}" ;; esac
    done
    t set-option -uw -t "$w" @agent_state \; set-option -uw -t "$w" @agent_since \; set-option -uw -t "$w" @agent_hold \; set-option -uw -t "$w" @agent_icon \; set-option -uw -t "$w" @agent_fg \; set-option -uw -t "$w" @agent_tab_saved
  done
  for p in $(t list-panes -a -F '#{pane_id}'); do
    t set-option -up -t "$p" @agent_pane_state \; set-option -up -t "$p" @agent_kind \; set-option -up -t "$p" @agent_name
  done
  t set-option -gu @agent_needs; t set-option -gu @agent_signal_command
  limits_clear
  restore_claude_statusline
  echo "agent-signal: removed formats, hooks, key bindings and window/pane state. Claude hooks in ~/.claude/settings.json are left for you to delete."
}

# --- dispatch --------------------------------------------------------------
usage() { sed -n '/^# Usage:/,/^set -u/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; }
case ${1:-} in
  hook)   [ -n "${2:-}" ] || { echo "agent-signal hook: which event? e.g. Stop" >&2; exit 1; }; hook "$2" ;;
  set)    [ -n "${2:-}" ] || { echo "agent-signal set: which state? working|blocked|ask|done|idle" >&2; exit 1; }; set_state "$2" "${3:-}" ;;
  clear)  set_state clear "${2:-}" ;;
  seen)   seen "${2:-}" ;;
  needs|summary) refresh_needs; refresh_progress ;;
  limits) if limits_on; then limits; else limits_clear; fi ;;   # switched off: nothing stays published
  statusline) shift; statusline "$*" ;;
  progress) case ${2:-} in ""|print|clear) refresh_progress "${2:-}" ;; *) echo "agent-signal progress: print or clear" >&2; exit 1 ;; esac ;;
  badge-format) printf '%s\n' "$BADGE" ;;
  window-format) printf '%s\n' "$WINDOW_FORMAT" ;;
  border-suffix) printf '%s\n' "$BORDER_SUFFIX" ;;
  lock-path) lock_path "${2:?window}" ;;
  next)   next ;;
  hold)   case ${2:-} in wait|park|clear) hold "$2" "${3:-}" ;; *) echo "agent-signal hold: wait, park or clear" >&2; exit 1 ;; esac ;;
  list)   list ;;
  sync)   sync_registry ;;
  install-claude-hooks) install_claude_hooks ;;
  install-claude-statusline) install_claude_statusline ;;
  uninstall) uninstall ;;
  check)  check ;;
  help|-h|--help) usage ;;
  version|--version) sed -n 's/^# agent-signal \([0-9.]*\):.*/\1/p' "$0" ;;
  "") usage >&2; exit 1 ;;
  *) echo "agent-signal: unknown command '$1'" >&2; usage >&2; exit 1 ;;
esac
